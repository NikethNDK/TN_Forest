# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Cloudinary Configuration
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_API_KEY=your-api-key

# Backend API (Django TN_Forest_Shop) for EcoStore admin – divisions, products, etc.
# Use the server origin only (e.g. http://localhost:8000). A trailing /api is stripped automatically.
VITE_SHOP_API_URL=http://localhost:8000

# Razorpay Standard Checkout (optional; must match backend RAZORPAY_ENABLED)
# See TN_Forest_Shop/docs/RAZORPAY.md for full setup (test + production).
VITE_RAZORPAY_CHECKOUT_ENABLED=false



ADMIN_EMAIL=<email>
ADMIN_PASSWORD=<password>

# EmailJS Configuration
VITE_EMAILJS_SERVICE_ID=service_id
VITE_EMAILJS_TEMPLATE_ID=template_rwzy41e
VITE_EMAILJS_PUBLIC_KEY=secret_key
VITE_ADMIN_EMAIL=<email>
VITE_EMAILJS_ORDER_ACCEPTED_TEMPLATE_ID=template_77wxrws
